[Unit]
Description=Back up the NapTable SQLite database
After=naptable.service

[Service]
Type=oneshot
User=naptable
Group=naptable
ExecStart=/usr/bin/python3.11 /opt/naptable/current/deploy/backup.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/naptable
ReadWritePaths=/var/backups/naptable
